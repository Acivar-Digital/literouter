{
  "name": "literouter",
  "version": "4.1.0",
  "description": "Ultra-fast declarative LLM API gateway and resilient proxy on Bun",
  "main": "src/index.ts",
  "types": "src/lib.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun run scripts/test_runner.ts",
    "test:lr": "bun run scripts/test_runner.ts",
    "test:gateway": "bun run scripts/test_runner.ts",
    "test:unit": "bun run scripts/test_runner.ts",
    "test:raw": "bun test",
    "test:eval": "bun run scripts/test_runner.ts eval",
    "test:failures": "bun test --only-failures",
    "typecheck": "tsc --noEmit",
    "doctor": "bun run scripts/doctor.ts",
    "flush": "bun run scripts/flush.ts",
    "guardrail": "bun run scripts/guardrail.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.5.4",
    "typescript": "^5.5.4"
  }
}
