{
  "name": "literouter",
  "version": "0.1.0",
  "template": "openai-compatible",
  "type": "module",
  "scripts": {
    "start": "bun src/server.ts",
    "preflight": "bun src/test.ts",
    "doctor": "bun src/doctor.ts",
    "lint": "biome check .",
    "debug": "DEBUG=1 bun src/server.ts",
    "stop": "lsof -ti:7766 | xargs kill -9 2>/dev/null && echo 'Stopped' || echo 'Not running'",
    "restart": "lsof -ti:7766 | xargs kill -9 2>/dev/null; sleep 0.5; bun src/server.ts",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/bun": "^1.1.0",
    "@types/node": "^25.5.2"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
