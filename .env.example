# Server
LITEROUTER_HOST=0.0.0.0
LITEROUTER_PORT=7766
LITEROUTER_AUTH_KEY=sk-lr-your-auth-key
LITEROUTER_ROTATE_DELAY_MS=2000
LITEROUTER_IDLE_TIMEOUT=60
LITEROUTER_TTFT_TIMEOUT_MS=120000

# Valkey (optional — leave REDIS_HOST empty to use in-memory mode. 
# Valkey is used on port 6379; we use REDIS_ environment variables for protocol compatibility)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password

# ────────────────────────────────────────────────────────────────────────────────
# DEFAULT TEMPLATE + PROVIDER
# Used when the model ID has no prefix (e.g., "claude-sonnet-4-6" instead of "anthropic/claude-sonnet-4-6")
#
# LITEROUTER_TEMPLATE = anthropic|openai
# LITEROUTER_PROVIDER = openrouter|anthropic|nvidia
# ────────────────────────────────────────────────────────────────────────────────
LITEROUTER_TEMPLATE=openai
LITEROUTER_PROVIDER=openrouter

# ────────────────────────────────────────────────────────────────────────────────
# PROVIDER: OpenRouter
# Model prefix: openrouter/
# ────────────────────────────────────────────────────────────────────────────────
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEYS=sk-or-key1,sk-or-key2,sk-or-key3
OPENROUTER_MIN_DELAY_MS=3000

# ────────────────────────────────────────────────────────────────────────────────
# PROVIDER: Nvidia
# Model prefix: nvidia/
# ────────────────────────────────────────────────────────────────────────────────
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEYS=nvapi-key1,nvapi-key2,nvapi-key3
NVIDIA_MIN_DELAY_MS=3000

# ────────────────────────────────────────────────────────────────────────────────
# PROVIDER: Anthropic (optional)
# Model prefix: anthropic/  (or use LITEROUTER_TEMPLATE=anthropic for unprefixed)
# ────────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEYS=sk-ant-key1,sk-ant-key2
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MIN_DELAY_MS=2000


# ────────────────────────────────────────────────────────────────────────────────
# TLS / HTTPS (optional)
# Generate certs: ./scripts/setup_certs.sh
# ────────────────────────────────────────────────────────────────────────────────
LITEROUTER_TLS_ENABLED=true
LITEROUTER_TLS_CERT=certs/localhost.pem
LITEROUTER_TLS_KEY=certs/localhost-key.pem

# ────────────────────────────────────────────────────────────────────────────────
# Parameter & Reasoning Scrubbing
# Set to false to disable parameter and reasoning scrubbing (default: false)
# ────────────────────────────────────────────────────────────────────────────────
LITEROUTER_ENABLE_SCRUBBING=false

# ────────────────────────────────────────────────────────────────────────────────
# Upstream Identity Headers (OpenRouter attribution & agentic harness whitelist)
# Set these to empty strings to strip attribution from upstream requests.
# LITEROUTER_HTTP_REFERER  — HTTP-Referer header sent to OpenRouter (default: https://opencode.ai)
# LITEROUTER_X_TITLE       — X-Title header sent to OpenRouter (default: OpenCode)
# LITEROUTER_USER_AGENT    — User-Agent header sent to OpenRouter (default: OpenCode/1.18.29)
# ────────────────────────────────────────────────────────────────────────────────
LITEROUTER_HTTP_REFERER=
LITEROUTER_X_TITLE=
LITEROUTER_USER_AGENT=OpenCode/1.18.29

