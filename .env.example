# Server
LITEROUTER_HOST=0.0.0.0
LITEROUTER_PORT=7766
LITEROUTER_AUTH_KEY=sk-lr-your-auth-key
LITEROUTER_ROTATE_DELAY_MS=2000

# Redis
REDIS_HOST=10.32.34.243
REDIS_PORT=12000
REDIS_DB=0
REDIS_PASSWORD=your-redis-password

# Providers
# Format: PROVIDER_BASE_URL, PROVIDER_API_KEYS (comma-separated), PROVIDER_MIN_DELAY_MS
# PROVIDER_MODEL, PROVIDER_TEMPERATURE, etc.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEYS=sk-or-key1,sk-or-key2
OPENROUTER_MIN_DELAY_MS=3000
OPENROUTER_MODEL=openrouter/owl-alpha
OPENROUTER_TEMPERATURE=0.0
OPENROUTER_REASON_EFFORT=xhigh
