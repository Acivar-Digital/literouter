{
  "providers": {
    "openrouter": {
      "code": "or",
      "name": "OpenRouter",
      "env_key": "OPENROUTER_API_KEYS",
      "strategy": "standard",
      "base_url": "https://openrouter.ai",
      "auth_header": "Bearer",
      "headers": {
        "HTTP-Referer": "https://opencode.ai",
        "X-Title": "OpenCode",
        "User-Agent": "OpenCode/1.18.29"
      },
      "endpoints": {
        "ch": "/api/v1/chat/completions",
        "ms": "/api/v1/messages",
        "em": "/api/v1/embeddings",
        "md": "/api/v1/models",
        "rs": "/api/v1/responses"
      },
      "conserve_rules": [
        {
          "status": 429,
          "contains": "free-models-per-day",
          "ttl": "midnight_utc",
          "reason": "openrouter_daily_free_quota_exhausted"
        }
      ],
      "request_retry": {
        "enabled": true,
        "max_attempts": 3,
        "delay": {
          "min_ms": 150,
          "max_ms": 500
        }
      },
      "pacer": {
        "enabled": true,
        "min_delay_ms": 200,
        "max_delay_ms": 500,
        "max_queue_depth": 500,
        "max_queue_wait_ms": 15000
      }
    },
    "nvidia": {
      "code": "nv",
      "name": "NVIDIA NIM",
      "env_key": "NVIDIA_API_KEYS",
      "strategy": "standard",
      "base_url": "https://integrate.api.nvidia.com",
      "auth_header": "Bearer",
      "endpoints": {
        "ch": "/v1/chat/completions",
        "em": "/v1/embeddings",
        "md": "/v1/models"
      },
      "request_retry": {
        "enabled": true,
        "max_attempts": 3,
        "delay": {
          "min_ms": 150,
          "max_ms": 300
        }
      },
      "pacer": {
        "enabled": true,
        "min_delay_ms": 200,
        "max_delay_ms": 500,
        "max_queue_depth": 500,
        "max_queue_wait_ms": 15000
      }
    },
    "google": {
      "code": "gg",
      "name": "Google AI Studio",
      "env_key": "GOOGLE_API_KEYS",
      "strategy": "native_cascade",
      "base_url": "https://generativelanguage.googleapis.com",
      "auth_header": "Bearer",
      "endpoints": {
        "ob": "/v1beta/openai/chat/completions",
        "gc": "/v1beta/models/{model}:generateContent",
        "g1": "/v1/models/{model}:generateContent",
        "em": "/v1beta/models/{model}:embedContent",
        "md": "/v1beta/models"
      },
      "request_retry": {
        "enabled": true,
        "max_attempts": 3,
        "delay": {
          "min_ms": 200,
          "max_ms": 500
        }
      },
      "pacer": {
        "enabled": true,
        "min_delay_ms": 200,
        "max_delay_ms": 500,
        "max_queue_depth": 500,
        "max_queue_wait_ms": 15000
      }
    },
    "zen": {
      "code": "zn",
      "name": "Zen",
      "env_key": "ZEN_API_KEYS",
      "strategy": "standard",
      "base_url": "https://opencode.ai/zen",
      "auth_header": "Bearer",
      "headers": {
        "HTTP-Referer": "https://opencode.ai",
        "Referer": "https://opencode.ai",
        "X-Title": "OpenCode",
        "User-Agent": "OpenCode/1.18.29"
      },
      "endpoints": {
        "ch": "/v1/chat/completions",
        "md": "/v1/models",
        "rs": "/v1/responses"
      },
      "request_retry": {
        "enabled": true,
        "max_attempts": 5,
        "delay": {
          "min_ms": 1000,
          "max_ms": 2000
        }
      },
      "pacer": {
        "enabled": true,
        "min_delay_ms": 1000,
        "max_delay_ms": 2000,
        "max_queue_depth": 500,
        "max_queue_wait_ms": 15000,
        "max_concurrency": 7
      }
    },
    "gcp": {
      "code": "gc",
      "name": "Google Cloud (GCP)",
      "env_key": "GCP_KEYS",
      "strategy": "gcp_guarded",
      "base_url": "https://generativelanguage.googleapis.com",
      "auth_header": "Bearer",
      "endpoints": {
        "ch": "/v1beta/openai/chat/completions",
        "ob": "/v1beta/openai/chat/completions",
        "gc": "/v1beta/models/{model}:generateContent",
        "em": "/v1beta/models/{model}:embedContent",
        "md": "/v1beta/models"
      },
      "request_retry": {
        "enabled": true,
        "max_attempts": 3,
        "delay": {
          "min_ms": 200,
          "max_ms": 500
        }
      },
      "pacer": {
        "enabled": true,
        "min_delay_ms": 2000,
        "max_delay_ms": 3000,
        "max_queue_depth": 500,
        "max_queue_wait_ms": 240000
      }
    }
  }
}
