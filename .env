# ─────────────────────────────────────────────────────────────────────────────
# LiteRouter Default Operational Configuration (Tracked in Git)
# Secrets & API keys belong strictly in .env.local (Git-Ignored)
# ─────────────────────────────────────────────────────────────────────────────

# Server Defaults
LITEROUTER_PORT=7766
LITEROUTER_HOST=0.0.0.0
LITEROUTER_ROTATE_DELAY_MS=10
LITEROUTER_KEY_ROTATE_DELAY_MS=10
LITEROUTER_MAX_ATTEMPTS=3
LITEROUTER_HTTP_TIMEOUT=60
LITEROUTER_IDLE_TIMEOUT=60
LITEROUTER_NO_RESPONSE_TIMEOUT=60
LITEROUTER_NO_RESPONSE_RETRY_DELAY=0
LITEROUTER_STREAM_IDLE_TIMEOUT=10
LITEROUTER_STRIP_REASONING=true
LITEROUTER_AO_STRIP_REASONING=true
LITEROUTER_COLLAPSE_REASONING=false

# Rate Pacer Configuration
LITEROUTER_PACER_ENABLED=true
LITEROUTER_PACER_MAX_RPM=30
LITEROUTER_PACER_MAX_QUEUE_DEPTH=100
LITEROUTER_PACER_MAX_QUEUE_WAIT_MS=4500

# Redis / Valkey Connection
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Fusion Sidecar & Routing Templates
FUSION_UPSTREAM_URL=http://localhost:7767/v1/chat/completions
FUSION_UPSTREAM_URL_NATIVE=http://localhost:7767/v1beta
LITEROUTER_TEMPLATE=openai
LITEROUTER_PROVIDER=openrouter

# Provider Base URLs & Delays
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MIN_DELAY_MS=10
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MIN_DELAY_MS=10
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_MIN_DELAY_MS=10
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_NATIVE_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_MIN_DELAY_MS=200
GOOGLE_KEY_AS_QUERY_PARAM=true

# Circuit Breakers, Cooldowns & Keep-Alives
FUSION_CIRCUIT_TTL_MS=6500
FUSION_STICKY_TTL_MS=30000
COOLDOWN_DEFAULT_TTL_SEC=30
COOLDOWN_RATE_LIMIT_TTL_SEC=10
COOLDOWN_TIMEOUT_TTL_SEC=10
COOLDOWN_AUTH_TTL_SEC=6048
COOLDOWN_TTL_MIN_SEC=5
COOLDOWN_TTL_MAX_SEC=720
GRACE_RETRY_DELAY_MS=150
STREAM_STALL_MAX_RESENDS=5
KEEPALIVE_INTERVAL_MS=200

# ─────────────────────────────────────────────────────────────────────────────
# Upstream Identity Headers (OpenRouter attribution)
# Set these to empty strings to strip attribution from upstream requests.
# LITEROUTER_HTTP_REFERER  — HTTP-Referer header sent to OpenRouter
# LITEROUTER_X_TITLE       — X-Title header sent to OpenRouter
# ─────────────────────────────────────────────────────────────────────────────
LITEROUTER_HTTP_REFERER=
LITEROUTER_X_TITLE=

# Default Models & Vendor Inheritances
GOOGLE_INTERACTIONS_MODEL=antigravity-preview-05-2026
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
NVIDIA_MODEL=openai/gpt-oss-120b
ZEN_MODEL=deepseek-v4-flash-free
GOOGLE_MODEL=gemma-4-26b-a4b-it



# Beads / Dolt Configuration
DOLT_ROOT_PATH=/home/yapilwsl/arthityap/literouter/.dolt
BEADS_DOLT_PASSWORD=ZysxTSZtlLL
LITEROUTER_TLS_ENABLED=true
LITEROUTER_HTTP2=true

# Rate Pacing and Request Serialization (Pure Conveyor Belt FIFO per provider)
LITEROUTER_PACER_ENABLED=true
LITEROUTER_PACER_MAX_RPM=600
LITEROUTER_PACER_MAX_QUEUE_DEPTH=100
