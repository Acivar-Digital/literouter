# ─────────────────────────────────────────────────────────────────────────────
# LiteRouter Default Operational Configuration (Tracked in Git)
# Secrets & API keys belong strictly in .env.local (Git-Ignored)
# ─────────────────────────────────────────────────────────────────────────────

# Server Defaults
LITEROUTER_PORT=7766
LITEROUTER_ROTATE_DELAY_MS=10000
LITEROUTER_MAX_ATTEMPTS=3
LITEROUTER_HTTP_TIMEOUT=300
LITEROUTER_NO_RESPONSE_TIMEOUT=5
LITEROUTER_STREAM_IDLE_TIMEOUT=30
LITEROUTER_NO_RESPONSE_RETRY_DELAY=1000
LITEROUTER_STRIP_REASONING=true
LITEROUTER_COLLAPSE_REASONING=false

# Provider Base URLs & Delays
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MIN_DELAY_MS=3000
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MIN_DELAY_MS=3000
ZEN_BASE_URL=https://opencode.zenfetch.com/v1
ZEN_MIN_DELAY_MS=3000
GOOGLE_MIN_DELAY_MS=2000

# Fusion Defaults
FUSION_CIRCUIT_TTL_MS=65000
FUSION_STICKY_TTL_MS=300000

# Beads / Dolt Configuration
DOLT_ROOT_PATH=/home/yapilwsl/arthityap/literouter/.dolt
BEADS_DOLT_PASSWORD=ZysxTSZtlLL
