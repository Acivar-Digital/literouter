# ─────────────────────────────────────────────────────────────────────────────
# LiteRouter Default Operational Configuration (Tracked in Git)
# Secrets & API keys belong strictly in .env.local (Git-Ignored)
# ─────────────────────────────────────────────────────────────────────────────

# Server Defaults
LITEROUTER_PORT=7766
LITEROUTER_HOST=0.0.0.0
LITEROUTER_ROTATE_DELAY_MS=5000
LITEROUTER_KEY_ROTATE_DELAY_MS=5000
LITEROUTER_MAX_ATTEMPTS=3
LITEROUTER_HTTP_TIMEOUT=800
LITEROUTER_IDLE_TIMEOUT=60
LITEROUTER_NO_RESPONSE_TIMEOUT=500
LITEROUTER_NO_RESPONSE_RETRY_DELAY=500
LITEROUTER_STREAM_IDLE_TIMEOUT=30
LITEROUTER_STRIP_REASONING=true
LITEROUTER_COLLAPSE_REASONING=false

# Rate Pacer Configuration
LITEROUTER_PACER_ENABLED=true
LITEROUTER_PACER_MAX_RPM=30
LITEROUTER_PACER_MAX_QUEUE_DEPTH=100
LITEROUTER_PACER_MAX_QUEUE_WAIT_MS=45000

# Redis / Valkey Connection
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Fusion Sidecar & Routing Templates
FUSION_UPSTREAM_URL=http://localhost:7767/v1/chat/completions
FUSION_UPSTREAM_URL_NATIVE=http://localhost:7767/v1beta
LITEROUTER_TEMPLATE=openai
LITEROUTER_PROVIDER=openrouter

# Provider Base URLs & Delays
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MIN_DELAY_MS=2000
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MIN_DELAY_MS=2000
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_MIN_DELAY_MS=2000
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_NATIVE_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_MIN_DELAY_MS=2000
GOOGLE_KEY_AS_QUERY_PARAM=true

# Circuit Breakers, Cooldowns & Keep-Alives
FUSION_CIRCUIT_TTL_MS=65000
FUSION_STICKY_TTL_MS=300000
COOLDOWN_DEFAULT_TTL_SEC=30
COOLDOWN_RATE_LIMIT_TTL_SEC=65
COOLDOWN_TIMEOUT_TTL_SEC=10
COOLDOWN_AUTH_TTL_SEC=604800
COOLDOWN_TTL_MIN_SEC=5
COOLDOWN_TTL_MAX_SEC=7200
GRACE_RETRY_DELAY_MS=1500
STREAM_STALL_MAX_RESENDS=3
KEEPALIVE_INTERVAL_MS=2000

# ─────────────────────────────────────────────────────────────────────────────
# Upstream Identity Headers (OpenRouter attribution)
# Set these to empty strings to strip attribution from upstream requests.
# LITEROUTER_HTTP_REFERER  — HTTP-Referer header sent to OpenRouter
# LITEROUTER_X_TITLE       — X-Title header sent to OpenRouter
# ─────────────────────────────────────────────────────────────────────────────
LITEROUTER_HTTP_REFERER=
LITEROUTER_X_TITLE=

# Default Models & Vendor Inheritances
GOOGLE_INTERACTIONS_MODEL=antigravity-preview-05-2026
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
NVIDIA_MODEL=openai/gpt-oss-120b
ZEN_MODEL=deepseek-v4-flash-free
GOOGLE_MODEL=gemma-4-26b-a4b-it

MINIMAXAI_INHERITS=NVIDIA
MINIMAXAI_MODEL=minimaxai/minimax-m3
MINIMAXAI_TEMPERATURE=1.00
MINIMAXAI_MAX_TOKENS=8192
MINIMAXAI_TOP_P=0.95

MOONSHOTAI_INHERITS=NVIDIA
MOONSHOTAI_MODEL=moonshotai/kimi-k2.6
MOONSHOTAI_TEMPERATURE=1.00
MOONSHOTAI_MAX_TOKENS=16384
MOONSHOTAI_TOP_P=1.00

STEPFUNAI_INHERITS=NVIDIA
STEPFUNAI_MODEL=stepfun-ai/step-3.7-flash
STEPFUNAI_TEMPERATURE=1.00
STEPFUNAI_MAX_TOKENS=16384
STEPFUNAI_TOP_P=0.95

MISTRAL_INHERITS=NVIDIA
MISTRAL_MODEL=mistralai/mistral-medium-3.5-128b
MISTRAL_TEMPERATURE=0.70
MISTRAL_MAX_TOKENS=16384
MISTRAL_TOP_P=1.00
MISTRAL_REASON_EFFORT=high

ZAI_INHERITS=NVIDIA
ZAI_MODEL=z-ai/glm-5.1
ZAI_TEMPERATURE=0.00
ZAI_MAX_TOKENS=65535
ZAI_TOP_P=1.00

DEEPSEEK_V4_PRO_INHERITS=NVIDIA
DEEPSEEK_V4_PRO_MODEL=deepseek-ai/deepseek-v4-pro
DEEPSEEK_V4_PRO_TEMPERATURE=1.00
DEEPSEEK_V4_PRO_MAX_TOKENS=16384
DEEPSEEK_V4_PRO_TOP_P=0.95
DEEPSEEK_V4_PRO_THINKING=False

DEEPSEEK_V4_FLASH_INHERITS=NVIDIA
DEEPSEEK_V4_FLASH_MODEL=deepseek-ai/deepseek-v4-flash
DEEPSEEK_V4_FLASH_TEMPERATURE=1.00
DEEPSEEK_V4_FLASH_MAX_TOKENS=16384
DEEPSEEK_V4_FLASH_TOP_P=0.95
DEEPSEEK_V4_FLASH_THINKING=True
DEEPSEEK_V4_FLASH_REASON_EFFORT=high

# Beads / Dolt Configuration
DOLT_ROOT_PATH=/home/yapilwsl/arthityap/literouter/.dolt
BEADS_DOLT_PASSWORD=ZysxTSZtlLL
LITEROUTER_TLS_ENABLED=true
